# Application
APP_NAME=Viral Video Generator
DEBUG=True
SECRET_KEY=your-secret-key-change-in-production
MOCK_MODE=False

# === AI Providers ===

# OpenAI (for LLM - gpt-4o-mini)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-key

# fal.ai (for image/video/music generation)
# Get key: https://fal.ai/dashboard/keys
FAL_KEY=your-fal-key

# Models
LLM_MODEL=gpt-4o-mini  # gpt-4o-mini, gpt-4o
IMAGE_MODEL=fal-ai/nano-banana-pro  # fal.ai image model
VIDEO_MODEL=fal-ai/veo3.1/image-to-video  # fal.ai video model
MUSIC_MODEL=fal-ai/lyria2  # fal.ai music model

# === Legacy (deprecated - will be removed) ===
# PIAPI_KEY=  # Deprecated: use OPENAI_API_KEY + FAL_KEY

# Instagram OAuth
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# TikTok OAuth
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=

# YouTube OAuth
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Database
DATABASE_URL=sqlite:///./generator.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/generator

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Storage Paths (relative to backend/)
DATA_DIR=data
TEMP_DIR=data/temp
MEDIA_DIR=data/media
MEDIA_IMAGES_DIR=data/media/images
MEDIA_VIDEOS_DIR=data/media/videos
MEDIA_AUDIO_DIR=data/media/audio
UPLOAD_DIR=data/uploads
GENERATED_DIR=data/generated
MAX_UPLOAD_SIZE=104857600  # 100MB
