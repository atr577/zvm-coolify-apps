# Application
APP_NAME=Viral Video Generator
DEBUG=True
SECRET_KEY=your-secret-key-change-in-production
MOCK_MODE=False

# PiAPI (единый провайдер для GPT + KLING)
# Получить ключ: https://piapi.ai/
PIAPI_KEY=your-piapi-key

# Модели (model-agnostic)
LLM_MODEL=gpt-4o-mini  # gpt-4o-mini, gpt-4o, claude-3-7-sonnet-20250219
VIDEO_MODEL=kling-2.5  # kling-1.5, kling-1.6, kling-2.1, kling-2.1-master, kling-2.5, kling-2.6
IMAGE_MODEL=qwen-image  # qwen-image, nano-banana-pro
MUSIC_MODEL=suno  # suno, music-u (Udio)

# OpenAI Direct (for GPT-4o-audio-preview - not available via PiAPI)
# Required for ai_music provider (hook analysis)
OPENAI_API_KEY=

# Instagram OAuth
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# TikTok OAuth
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=

# YouTube OAuth
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Database
DATABASE_URL=sqlite:///./generator.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/generator

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Storage Paths (relative to backend/)
DATA_DIR=data
TEMP_DIR=data/temp
MEDIA_DIR=data/media
MEDIA_IMAGES_DIR=data/media/images
MEDIA_VIDEOS_DIR=data/media/videos
MEDIA_AUDIO_DIR=data/media/audio
UPLOAD_DIR=data/uploads
GENERATED_DIR=data/generated
MAX_UPLOAD_SIZE=104857600  # 100MB
